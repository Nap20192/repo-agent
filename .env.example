# repo-agent2 — пример окружения. Скопируйте в .env и заполните.
#   cp .env.example .env
# .env в .gitignore и запрещён для чтения агентом (.claude/settings.json).
# Пустое значение = дефолт из scanner/core/settings.py. Фича-флаги выключаются строго "0".

# ── модель ─────────────────────────────────────────────────────────────────────
# Вариант A: Google Gemini (дефолтная модель — gemini-flash-lite-latest)
GOOGLE_API_KEY=
# Вариант B: любой OpenAI-совместимый API (вместо GOOGLE_API_KEY)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# локальная ollama — то, на чём гоняются тесты агентов (CLAUDE.md):
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=openai/qwen3:1.7b

# ── граф ───────────────────────────────────────────────────────────────────────
BUGFINDER_MAX_ROUNDS=4
BUGFINDER_MAX_HYPS=8
BUGFINDER_MAX_PARALLEL=3
STAGE_TIMEOUT=600
THREAT_MODEL=1         # 0 = без Architect/ThreatModeler
CRITIC=1               # 0 = без адверсариального прохода

# ── бюджеты вызовов модели ─────────────────────────────────────────────────────
VERIFIER_MAX_MODEL_CALLS=30
CRITIC_MAX_MODEL_CALLS=20
MODEL_MAX_MODEL_CALLS=40

# ── state ──────────────────────────────────────────────────────────────────────
STATE_PATH=.state/state.db
SESSIONS_PATH=.state/sessions.db      # ADK-сессии, видны через adk web

# ── статические сканеры ────────────────────────────────────────────────────────
SKIP_DEPS=0            # 1 = пропустить osv-scanner
OSV_MAX=40             # максимум уязвимых пакетов из osv (самые «advisory-насыщенные»)
SEMGREP_CONFIG=        # пусто → паки по языкам; "auto" или свой путь/правило

# ── индекс кода (LSP/grep) ─────────────────────────────────────────────────────
INDEX_MAX_FILES=3000
INDEX_MAX_BYTES=31457280

# ── наблюдаемость ──────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=          # например http://localhost:4318
OTEL_SERVICE_NAME=scanner
LOG_LEVEL=INFO

# ── eval / R&D ─────────────────────────────────────────────────────────────────
LIVE_EVAL=0            # 1 = гонять живые модели (маркер pytest "live")
EVAL_MODEL=            # модель для eval.agents, напр. openai/qwen3:1.7b
EVAL_BUDGET=
EVAL_ONLY=             # прогнать только указанных агентов
BUGFINDER_TARGET=      # цель для web/<agent> (чат с одним агентом); fullscan берёт цель из сообщения
WORKSPACE_ROOT=        # adk web/fullscan: путь из сообщения должен лежать под этим каталогом (пусто = cwd); клоны — в .targets/ под ним
OWASP_REPOS=           # локальные корпуса OWASP для скилла owasp-rnd

# ── Windows ────────────────────────────────────────────────────────────────────
# Без UTF-8-режима сбор тестов падает на cp1252 (код читает файлы без encoding=):
PYTHONUTF8=1
